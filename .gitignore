# Generated locally, but NOTE: funders.json, partners.json, leads.json,
# and docs/index.html are intentionally tracked in git — the daily
# GitHub Actions workflow updates and commits them automatically.
# Only the local SQLite file itself stays untracked (it's rebuilt fresh
# from the JSON files every run, so there's nothing lost by ignoring it).
affa_crm.db
affa_campaign.html

# Backend's local SQLite fallback (used only when DATABASE_URL isn't set,
# e.g. running uvicorn directly without Docker/Postgres). The real data
# lives in Postgres via docker-compose; this file is dev-only scratch.
backend/affa_api.db
_merge_tmp/

