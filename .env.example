# Copy this file to .env and fill in your keys.
# .env is already gitignored — never commit real keys.

# Required for funding_agent.py, partnership_agent.py, outreach_agent.py,
# campaign_agent.py (all use the Anthropic API with the web_search tool).
ANTHROPIC_API_KEY=

# Only needed if you use funding_agent_gemini.py instead of the Anthropic
# funding agent.
GEMINI_API_KEY=
